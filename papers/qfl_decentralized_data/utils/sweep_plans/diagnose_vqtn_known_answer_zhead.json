      "init_std": 0.1
    },
    "training": {
      "lr": 0.03
    }
  },
  "candidates": [
    {
      "name": "known_answer_0v1_z_head",
      "overrides": {
        "dataset.classes": [
          0,
          1
        ],
        "model.readout": "z_head"
      }
    }
  ],
  "seeds": [
    1,
    2,
    3
  ],
  "workers": 3,
  "threads_per_worker": 3,
  "selection": {
    "metric": "validation_accuracy",
    "split": "validation",
    "checkpoint": "last",
    "direction": "maximize",
    "aggregation": "mean",
    "tie_tolerance": 0.005,
    "tie_handling": "diagnosis only: no candidate is selected; all means are reported against the baseline"
  }
