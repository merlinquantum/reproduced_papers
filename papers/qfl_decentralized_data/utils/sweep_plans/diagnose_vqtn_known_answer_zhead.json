{
  "sweep_id": "diagnose_vqtn_known_answer_zhead",
  "purpose": "Separate an implementation bug from a read-out capacity limit: repeat the easy 0 vs 1 known-answer task with the diagnostic read-out head (amendment written after the components sweep showed the known-answer failure)",
  "paper": "qfl_decentralized_data",
  "base_config": "configs/e1_centralized.json",
  "fixed_overrides": {
    "dataset": {
      "validation_fraction": 0.1
    },
    "model": {
