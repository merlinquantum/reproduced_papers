{
    "description": "Phase 04 MerLin adaptation of the B5 distinguishable twin for Fig. 3a (sigma=3), MerLin backend.",
    "experiment": {
        "name": "fig3a_bs_merlin_classical",
        "paper_reference": "Fig. 3a B5 (MerLin adaptation)"
    },
    "dataset": {
        "name": "boson_sampling",
        "m": 256,
        "n": 16,
        "n_train": 5000,
        "n_test": 5000,
        "input_state": "middle_compact",
        "unitary_seed": 2603,
        "sample_seed": 8793
    },
    "model": {
        "ansatz": "haar",
        "butterfly_variant": "reference",
        "input_state": "middle_alternating",
        "photon_model": "distinguishable",
        "backend": "merlin"
    },
    "kernel": {
        "type": "gaussian",
        "sigma": 3.0
    },
    "init": {
        "strategy": "identity",
        "perturbation": 0.01
    },
    "training": {
        "steps": 2000,
        "learning_rate": 0.01,
        "n_operators": 2000,
        "n_gurvits": 5000,
        "convergence_interval": 200,
        "log_every": 1
    },
    "evaluation": {
        "n_operators": 2000,
        "n_gurvits": 5000,
        "sample_metrics": true,
        "num_model_samples": 2000,
        "baselines": [],
        "sampler": "merlin_clifford"
    }
}
