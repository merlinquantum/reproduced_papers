{
    "description": "Fig. 3d RED-tier override: |K|=1500, |Z|=1000, no RBM; label 'partial RED-tier run'.",
    "experiment": {
        "name": "fig3d_movies_butterfly_reduced",
        "paper_reference": "Fig. 3d (reduced)"
    },
    "dataset": {
        "name": "movies",
        "m": 100,
        "n": 10,
        "n_train": 10000,
        "n_test": 10000,
        "seed": 42,
        "min_date": "2005-01-01"
    },
    "model": {
        "ansatz": "butterfly",
        "butterfly_variant": "reference",
        "input_state": "middle_alternating",
        "photon_model": "indistinguishable"
    },
    "kernel": {
        "type": "gaussian",
        "sigma": 2.5
    },
    "init": {
        "strategy": "identity",
        "perturbation": 0.01,
        "steps": 5000,
        "learning_rate": 0.5
    },
    "training": {
        "steps": 2000,
        "learning_rate": 0.01,
        "n_operators": 1500,
        "n_gurvits": 1000,
        "convergence_interval": 200,
        "log_every": 1
    },
    "evaluation": {
        "n_operators": 1500,
        "n_gurvits": 1000,
        "sample_metrics": true,
        "num_model_samples": 2000,
        "baselines": [
            "random",
            "marginal",
            "test_to_test"
        ]
    }
}
