{
    "description": "Fig. 4b: mushroom one-hot blocks (m=100, n=10), Haar, Gaussian sigma=2, input on the first mode of each block; sweep --init weak_unbiased/data_dependent/identity/block_uniform/random, 5 instances, up to 500 steps or convergence.",
    "experiment": {
        "name": "fig4b_mushroom",
        "paper_reference": "Fig. 4b"
    },
    "dataset": {
        "name": "mushroom_blocks",
        "m": 100,
        "n": 10,
        "n_columns": 10,
        "n_train": 5000,
        "n_test": 1000,
        "seed": 0
    },
    "model": {
        "ansatz": "haar",
        "butterfly_variant": "reference",
        "input_state": "blocks",
        "photon_model": "indistinguishable"
    },
    "kernel": {
        "type": "gaussian",
        "sigma": 2.0
    },
    "init": {
        "strategy": "block_uniform",
        "block_sizes": [
            6,
            4,
            10,
            2,
            9,
            2,
            2,
            2,
            12,
            2
        ],
        "perturbation": 0.01,
        "steps": 5000,
        "learning_rate": 0.5
    },
    "training": {
        "steps": 500,
        "learning_rate": 0.01,
        "n_operators": 1500,
        "n_gurvits": 1000,
        "convergence_interval": 200,
        "log_every": 1
    },
    "evaluation": {
        "n_operators": 1500,
        "n_gurvits": 1000,
        "sample_metrics": true,
        "num_model_samples": 2000,
        "baselines": [
            "random",
            "marginal",
            "test_to_test"
        ]
    }
}
