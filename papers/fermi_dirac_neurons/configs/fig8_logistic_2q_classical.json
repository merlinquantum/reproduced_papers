{
  "description": "Fig. 8 / Table II fair baseline on the notebook data, 2 qubits: B2 classical logistic regression on the Heisenberg Pauli features",
  "experiment": {
    "task": "train",
    "id": "fig8_logistic_2q_classical"
  },
  "data": {
    "n_qubits": 2,
    "train_states": {
      "set": "haar",
      "n_states": 1000
    },
    "validation_states": {
      "set": "haar",
      "n_states": 500
    },
    "label_rule": "sign_linear",
    "target": {
      "term_set": "heisenberg",
      "include_identity": false,
      "low": -2.0,
      "high": 2.0,
      "function": "linear"
    }
  },
  "models": [
    {
      "name": "b2_pauli_features",
      "kind": "pauli_features",
      "term_set": "heisenberg",
      "include_identity": false,
      "activation": "tanh"
    }
  ],
  "training": {
    "loss": "logistic",
    "learning_rate": 0.05,
    "epochs": 500,
    "eval_every": 20,
    "init_low": -0.5,
    "init_high": 0.5
  }
}
