{
  "description": "E9b: Fig. 7a protocol with finite-shot gradients, 100 shots per state and parameter (Algorithms 1 and 2)",
  "experiment": {
    "task": "train",
    "id": "e9b_fig7_tanh_2q_shots100"
  },
  "data": {
    "n_qubits": 2,
    "train_states": {
      "set": "code_squared_loss"
    },
    "validation_states": {
      "set": "haar",
      "n_states": 500
    },
    "label_rule": "regression",
    "target": {
      "term_set": "tfim",
      "include_identity": true,
      "low": -2.0,
      "high": 2.0,
      "function": "tanh"
    }
  },
  "models": [
    {
      "name": "quantum_tfim",
      "kind": "hamiltonian",
      "term_set": "tfim",
      "include_identity": true,
      "activation": "tanh"
    },
    {
      "name": "classical_im",
      "kind": "hamiltonian",
      "term_set": "ising",
      "include_identity": true,
      "activation": "tanh"
    }
  ],
  "training": {
    "loss": "squared",
    "learning_rate": 0.1,
    "epochs": 2000,
    "eval_every": 100,
    "init_low": -0.5,
    "init_high": 0.5,
    "finite_shots": 100
  }
}
