{
  "description": "Fig. 8 / Table II, 2 qubits: logistic loss, Heisenberg vs FCIM, paper-text protocol (X/Y/Z product-basis train states, labels sign Tr[g_T(H*) rho], eta = 0.1)",
  "experiment": {
    "task": "train",
    "id": "fig8_logistic_2q_papertext"
  },
  "data": {
    "n_qubits": 2,
    "train_states": {
      "set": "pauli_basis"
    },
    "validation_states": {
      "set": "haar",
      "n_states": 500
    },
    "label_rule": "sign_activation",
    "target": {
      "term_set": "heisenberg",
      "include_identity": false,
      "low": -2.0,
      "high": 2.0,
      "function": "tanh"
    }
  },
  "models": [
    {
      "name": "quantum_heisenberg",
      "kind": "hamiltonian",
      "term_set": "heisenberg",
      "include_identity": false,
      "activation": "tanh"
    },
    {
      "name": "classical_fcim",
      "kind": "hamiltonian",
      "term_set": "fcim",
      "include_identity": false,
      "activation": "tanh"
    }
  ],
  "training": {
    "loss": "logistic",
    "learning_rate": 0.1,
    "epochs": 500,
    "eval_every": 20,
    "init_low": -0.5,
    "init_high": 0.5
  }
}
