{
  "description": "Fig. 7b fair baselines on the notebook data: B2 classical neuron on TFIM Pauli features (tanh), B3 quantum linear model, 7 qubits",
  "experiment": {
    "task": "train",
    "id": "fig7_tanh_7q_classical"
  },
  "data": {
    "n_qubits": 7,
    "train_states": {
      "set": "code_squared_loss"
    },
    "validation_states": {
      "set": "haar",
      "n_states": 500
    },
    "label_rule": "regression",
    "target": {
      "term_set": "tfim",
      "include_identity": true,
      "low": -2.0,
      "high": 2.0,
      "function": "tanh"
    }
  },
  "models": [
    {
      "name": "b2_pauli_features",
      "kind": "pauli_features",
      "term_set": "tfim",
      "include_identity": true,
      "activation": "tanh"
    },
    {
      "name": "b3_quantum_linear",
      "kind": "pauli_features",
      "term_set": "tfim",
      "include_identity": true,
      "activation": "linear"
    }
  ],
  "training": {
    "loss": "squared",
    "learning_rate": 0.1,
    "epochs": 2000,
    "eval_every": 100,
    "init_low": -0.5,
    "init_high": 0.5
  }
}
