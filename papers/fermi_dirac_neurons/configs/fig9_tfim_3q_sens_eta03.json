{
  "description": "Fig. 9b sensitivity: eta = 0.3 instead of 0.1",
  "experiment": {
    "task": "train",
    "id": "fig9_tfim_3q_sens_eta03"
  },
  "data": {
    "n_qubits": 3,
    "train_states": {
      "set": "code_squared_loss"
    },
    "validation_states": {
      "set": "haar",
      "n_states": 500
    },
    "label_rule": "regression",
    "target": {
      "term_set": "tfim",
      "include_identity": true,
      "low": -2.0,
      "high": 2.0,
      "function": "tanh"
    }
  },
  "models": [
    {
      "name": "quantum_tfim_tanh",
      "kind": "hamiltonian",
      "term_set": "tfim",
      "include_identity": true,
      "activation": "tanh"
    },
    {
      "name": "quantum_tfim_linear",
      "kind": "hamiltonian",
      "term_set": "tfim",
      "include_identity": true,
      "activation": "linear"
    },
    {
      "name": "classical_ising",
      "kind": "hamiltonian",
      "term_set": "ising",
      "include_identity": true,
      "activation": "tanh"
    }
  ],
  "training": {
    "loss": "squared",
    "learning_rate": 0.3,
    "epochs": 10000,
    "eval_every": 1000,
    "init_low": -0.5,
    "init_high": 0.5
  }
}
