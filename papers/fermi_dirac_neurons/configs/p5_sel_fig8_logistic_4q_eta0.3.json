{
  "description": "Phase 5 stage A: fig8_logistic_4q (original protocol) with B1, B2, B3 at learning rate 0.3, 20 % of the training states held out for selection",
  "experiment": {
    "task": "train",
    "id": "p5_sel_fig8_logistic_4q_eta0.3"
  },
  "data": {
    "n_qubits": 4,
    "train_states": {
      "set": "haar",
      "n_states": 1000
    },
    "validation_states": {
      "set": "haar",
      "n_states": 500
    },
    "label_rule": "sign_linear",
    "target": {
      "term_set": "heisenberg",
      "include_identity": false,
      "low": -2.0,
      "high": 2.0,
      "function": "linear"
    },
    "selection_fraction": 0.2
  },
  "models": [
    {
      "name": "quantum_heisenberg",
      "kind": "hamiltonian",
      "term_set": "heisenberg",
      "include_identity": false,
      "activation": "tanh"
    },
    {
      "name": "classical_fcim",
      "kind": "hamiltonian",
      "term_set": "fcim",
      "include_identity": false,
      "activation": "tanh"
    },
    {
      "name": "b2_pauli_features",
      "kind": "pauli_features",
      "term_set": "heisenberg",
      "include_identity": false,
      "activation": "tanh"
    }
  ],
  "training": {
    "loss": "logistic",
    "learning_rate": 0.3,
    "epochs": 500,
    "eval_every": 20,
    "init_low": -0.5,
    "init_high": 0.5,
    "on_nonfinite": "freeze"
  }
}
