{
  "description": "E8 (C8): fig8_logistic_3q original protocol, training states = basis (8 states), validation 500 Haar states",
  "experiment": {
    "task": "train",
    "id": "e8_fig8_logistic_3q_basis"
  },
  "data": {
    "n_qubits": 3,
    "train_states": {
      "set": "computational_basis"
    },
    "validation_states": {
      "set": "haar",
      "n_states": 500
    },
    "label_rule": "sign_linear",
    "target": {
      "term_set": "heisenberg",
      "include_identity": false,
      "low": -2.0,
      "high": 2.0,
      "function": "linear"
    }
  },
  "models": [
    {
      "name": "quantum_heisenberg",
      "kind": "hamiltonian",
      "term_set": "heisenberg",
      "include_identity": false,
      "activation": "tanh"
    },
    {
      "name": "classical_fcim",
      "kind": "hamiltonian",
      "term_set": "fcim",
      "include_identity": false,
      "activation": "tanh"
    }
  ],
  "training": {
    "loss": "logistic",
    "learning_rate": 0.05,
    "epochs": 500,
    "eval_every": 20,
    "init_low": -0.5,
    "init_high": 0.5
  }
}
