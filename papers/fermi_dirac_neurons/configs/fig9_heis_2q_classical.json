{
  "description": "Fig. 9c fair baseline B2: classical tanh neuron on the heisenberg Pauli features, 2 qubits",
  "experiment": {
    "task": "train",
    "id": "fig9_heis_2q_classical"
  },
  "data": {
    "n_qubits": 2,
    "train_states": {
      "set": "code_squared_loss"
    },
    "validation_states": {
      "set": "haar",
      "n_states": 500
    },
    "label_rule": "regression",
    "target": {
      "term_set": "heisenberg",
      "include_identity": false,
      "low": -2.0,
      "high": 2.0,
      "function": "tanh"
    }
  },
  "models": [
    {
      "name": "b2_pauli_features",
      "kind": "pauli_features",
      "term_set": "heisenberg",
      "include_identity": false,
      "activation": "tanh"
    }
  ],
  "training": {
    "loss": "squared",
    "learning_rate": 0.1,
    "epochs": 10000,
    "eval_every": 1000,
    "init_low": -0.5,
    "init_high": 0.5
  }
}
