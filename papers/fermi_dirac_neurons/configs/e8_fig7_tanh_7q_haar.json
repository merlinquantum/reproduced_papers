{
  "description": "E8 (C8): fig7_tanh_7q original protocol, training states = haar (128 states), validation 500 Haar states",
  "experiment": {
    "task": "train",
    "id": "e8_fig7_tanh_7q_haar"
  },
  "data": {
    "n_qubits": 7,
    "train_states": {
      "set": "haar",
      "n_states": 128
    },
    "validation_states": {
      "set": "haar",
      "n_states": 500
    },
    "label_rule": "regression",
    "target": {
      "term_set": "tfim",
      "include_identity": true,
      "low": -2.0,
      "high": 2.0,
      "function": "tanh"
    }
  },
  "models": [
    {
      "name": "quantum_tfim",
      "kind": "hamiltonian",
      "term_set": "tfim",
      "include_identity": true,
      "activation": "tanh"
    },
    {
      "name": "classical_im",
      "kind": "hamiltonian",
      "term_set": "ising",
      "include_identity": true,
      "activation": "tanh"
    }
  ],
  "training": {
    "loss": "squared",
    "learning_rate": 0.1,
    "epochs": 2000,
    "eval_every": 100,
    "init_low": -0.5,
    "init_high": 0.5
  }
}
