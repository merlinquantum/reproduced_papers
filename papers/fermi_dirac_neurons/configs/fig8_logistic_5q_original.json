{
  "description": "Fig. 8 / Table II, 5 qubits: logistic loss, Heisenberg vs FCIM, notebook protocol (1000 Haar train, labels sign Tr[H* rho])",
  "experiment": {
    "task": "train",
    "id": "fig8_logistic_5q"
  },
  "data": {
    "n_qubits": 5,
    "train_states": {
      "set": "haar",
      "n_states": 1000
    },
    "validation_states": {
      "set": "haar",
      "n_states": 500
    },
    "label_rule": "sign_linear",
    "target": {
      "term_set": "heisenberg",
      "include_identity": false,
      "low": -2.0,
      "high": 2.0,
      "function": "linear"
    }
  },
  "models": [
    {
      "name": "quantum_heisenberg",
      "kind": "hamiltonian",
      "term_set": "heisenberg",
      "include_identity": false,
      "activation": "tanh"
    },
    {
      "name": "classical_fcim",
      "kind": "hamiltonian",
      "term_set": "fcim",
      "include_identity": false,
      "activation": "tanh"
    }
  ],
  "training": {
    "loss": "logistic",
    "learning_rate": 0.05,
    "epochs": 500,
    "eval_every": 20,
    "init_low": -0.5,
    "init_high": 0.5
  }
}
