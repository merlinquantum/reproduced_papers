{
  "description": "E6 (Table XIII): one-day-ahead 5-day realized variance on one asset (default ^GSPC; override with --vol-ticker). Features: 5 return lags + 5 RV lags (10 angle-encoded qubits). Expanding window from 720 days, refit every 120 days, Optuna TPE per refit with equal trial budgets.",
  "task": "volatility",
  "volatility": {
    "dataset": {
      "ticker": "^GSPC",
      "start": "2005-01-01",
      "end": "2024-12-31",
      "return_lags": 5,
      "rv_lags": 5,
      "initial_train_days": 720,
      "refit_every": 120,
      "max_train_days": null,
      "batch_size": 256
    },
    "models": ["persistence", "har", "garch", "svr_linear", "svr_poly", "svr_rbf", "svr_rbf_wide", "qsvr_angle"],
    "qsvr": {
      "angle_scale": 3.141592653589793,
      "layers": [0, 1, 2, 3],
      "topologies": ["ring", "chain"],
      "rotation_seed": 1234,
      "amplitude_betas": [1, 2, 3]
    },
    "tuning": {
      "n_trials": 50,
      "tune_every_n_refits": 1,
      "validation_fraction": 0.2,
      "C": [0.01, 100.0],
      "epsilon": [0.001, 1.0],
      "rbf_wide_gamma": [0.001, 100.0],
      "sampler_seed": 0
    }
  }
}
