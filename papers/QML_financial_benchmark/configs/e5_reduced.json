{
  "description": "E5 smoke (reduced, not a paper result): one QLSTM (q=3, L=2) and one LSTM (h=3, 2 layers), 2 epochs, regime F1.",
  "task": "trading",
  "trading": {
    "dataset": {
      "ticker": "^GSPC",
      "window": 10,
      "regime": "F1",
      "regimes": {
        "F1": ["2008-01-02", "2009-12-31"],
        "F2": ["2018-01-02", "2019-12-31"],
        "F3": ["2020-01-02", "2021-12-31"],
        "F4": ["2022-01-03", "2024-12-31"]
      },
      "split_mode": "history_then_regime",
      "history_start": "2003-01-01",
      "split_fractions": [0.7, 0.1, 0.1, 0.1],
      "batch_size": 32
    },
    "models": {
      "qlstm": {"n_qubits": [3], "layers": [2], "topology": "chain"},
      "lstm": {"hidden_size": [3], "layers": [2]}
    },
    "training": {"lr": 0.001, "batch_size": 32, "max_epochs": 2, "patience": 30, "class_weighting": "balanced"},
    "backtest": {"fee": 0.0005, "tau_long_grid": [0.5, 0.9, 0.05], "tau_short_grid": [0.1, 0.5, 0.05]},
    "selection": {"tie_tolerance": 0.0001, "parameter_match_tolerance": 0.25}
  }
}
