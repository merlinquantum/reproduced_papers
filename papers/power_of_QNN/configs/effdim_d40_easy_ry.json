{
  "description": "A-03: easy quantum model with footnote-6 RY angle encoding vs the released ZFeatureMap encoding, d=40, theta ~ U[0,1].",
  "experiment": {
    "name": "effdim_d40_easy_ry",
    "kind": "fisher_effective_dimension"
  },
  "fisher": {
    "num_thetas": 100,
    "num_inputs": 100,
    "theta_low": 0.0,
    "theta_high": 1.0,
    "draw_seeds": [
      0,
      1,
      2,
      3,
      4
    ],
    "chunk_size": 100,
    "gamma": 1.0,
    "n_values": [
      1000,
      2000,
      8000,
      10000,
      40000,
      60000,
      100000,
      150000,
      200000,
      500000,
      1000000
    ],
    "zero_tolerance": 1e-10,
    "save_fhat_draws": [
      0
    ]
  },
  "models": [
    {
      "name": "easy_qnn_ry",
      "type": "qubit",
      "n_qubits": 4,
      "feature_map": "ry_angle",
      "feature_map_reps": 1,
      "ansatz_reps": 9,
      "feature_entanglement": "full",
      "ansatz_entanglement": "full",
      "hadamard_every_rep": true
    },
    {
      "name": "easy_qnn",
      "type": "qubit",
      "n_qubits": 4,
      "feature_map": "z",
      "feature_map_reps": 1,
      "ansatz_reps": 9,
      "feature_entanglement": "full",
      "ansatz_entanglement": "full",
      "hadamard_every_rep": true
    }
  ]
}
