{
  "description": "MerLin adaptation (Phase 04), Amendment 5 SCREEN (loss): B1-B6 on the Iris 1/2 split, lr in {0.1, 0.3} selected on mean final validation CE of seeds 0-9; final seeds 200-209 diagnostic only.",
  "experiment": {
    "name": "tier4_screen_train",
    "kind": "fair_comparison"
