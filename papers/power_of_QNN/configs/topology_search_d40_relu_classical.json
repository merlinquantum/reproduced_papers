{
  "description": "B-1: as topology_search_d40_classical but with ReLU hidden layers, a plain softmax head and symmetric theta ~ U[-1,1].",
  "experiment": {
    "name": "topology_search_d40_relu_classical",
    "kind": "topology_search"
  },
  "fisher": {
    "num_thetas": 100,
    "num_inputs": 100,
    "theta_low": -1.0,
    "theta_high": 1.0,
    "draw_seeds": [
      0,
      1,
      2
    ],
    "chunk_size": 100,
    "gamma": 1.0,
    "n_values": [
      1000,
      2000,
      8000,
      10000,
      40000,
      60000,
      100000,
      150000,
      200000,
      500000,
      1000000
    ],
    "zero_tolerance": 1e-10,
    "save_fhat_draws": [
      0
    ]
  },
  "topology_search": {
    "input_size": 4,
    "output_size": 2,
    "target_d": 40,
    "max_hidden_layers": 3,
    "bias": false,
    "selection_n": 100000,
    "tie_tolerance": 0.001,
    "activation": "relu",
    "head": "softmax"
  }
