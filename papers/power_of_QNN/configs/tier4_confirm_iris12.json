{
  "description": "MerLin adaptation (Phase 04), design search 4 (LOG.md Amendment 5) CONFIRMATION: the photonic 6-mode design (B2) under the exact Phase 05 held-out Iris 1/2 protocol; baselines are the fair_iris12_d40 run.",
  "experiment": {
    "name": "tier4_confirm_iris12",
    "kind": "fair_comparison"
  },
  "dataset": {
    "name": "iris_pair",
    "classes": [
      1,
      2
    ],
    "split_seed": 0,
    "per_class": {
      "train": 30,
      "validation": 10,
      "test": 10
    },
    "batch_size": null
  },
  "training": {
    "iterations": 100,
    "lr": 0.1,
    "finite_difference_step": 1e-10,
    "log_every": 1,
    "loss_threshold": 0.3
  },
  "comparison": {
    "lr_grid": [
      0.01,
      0.03,
      0.1,
      0.3
    ],
    "selection_seeds": {
      "start": 0,
      "count": 20
    },
    "final_seeds": {
      "start": 100,
      "count": 100
    },
    "tie_tolerance": 0.005,
    "splits": [
      "train",
      "validation",
      "test"
    ],
    "selection_split": "validation"
  },
  "models": [
    {
      "name": "B2_6m_cluster",
      "type": "photonic",
      "n_inputs": 4,
      "encoding": "hard",
      "d": 40,
      "detection": "threshold",
      "extra_modes": 2,
      "mesh_order": "ps_bs",
      "layout": "interleaved",
      "input_kind": "cluster",
      "readout": "click_parity",
      "data_reps": 3,
      "training": {
        "optimizer": "torch_adam",
        "gradient": "autograd",
        "init": {
          "low": -1.0,
          "high": 1.0
        }
      }
    }
  ]
}
