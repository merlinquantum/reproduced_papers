{
  "description": "B-2: every bias-free d=8 classical network for s_in=4, s_out=2 ([4,2] linear softmax and [4,1,1,1,2]), torch Adam, init U[-1,1]; lr is set per run with --lr for the predeclared grid {0.01, 0.03, 0.1, 0.3}.",
  "experiment": {
    "name": "training_iris_classical",
    "kind": "training"
  },
  "dataset": {
    "name": "iris_binary",
    "batch_size": null
  },
  "training": {
    "iterations": 100,
    "lr": 0.1,
    "seeds": {
      "start": 0,
      "count": 100
    },
    "finite_difference_step": 1e-10,
    "log_every": 1,
    "loss_threshold": 0.3,
    "fisher_rao": true,
    "fisher_chunk_size": 100
  },
  "models": [
    {
      "name": "classical_42",
      "type": "classical",
      "sizes": [
        4,
        2
      ],
      "activation": "leaky_relu",
      "head": "softmax",
      "bias": false,
      "training": {
        "optimizer": "torch_adam",
        "gradient": "autograd",
        "init": {
          "low": -1.0,
          "high": 1.0
        }
      }
    },
    {
      "name": "classical_41112",
      "type": "classical",
      "sizes": [
        4,
        1,
        1,
        1,
        2
      ],
      "activation": "leaky_relu",
      "head": "softmax",
      "bias": false,
      "training": {
        "optimizer": "torch_adam",
        "gradient": "autograd",
        "init": {
          "low": -1.0,
          "high": 1.0
        }
      }
    }
  ]
}
