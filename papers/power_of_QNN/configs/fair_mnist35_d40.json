{
  "description": "Phase 05 held-out comparison on MNIST 3 vs 5 (4 PCA features, 500/500/1902; advantage evidence): photonic 6-mode (B2), qubit QNN (paper) and with 3 uploads, classical [4,6,2,2] and the d=8 linear reference; fair_iris01_d40 protocol.",
  "experiment": {
    "name": "fair_mnist35_d40",
    "kind": "fair_comparison"
  },
  "dataset": {
    "name": "prepared_split",
    "subdir": "mnist",
    "file": "mnist35_pca4_train500_val500_test_rs0.npz",
    "batch_size": null
  },
  "training": {
    "iterations": 100,
    "lr": 0.1,
    "finite_difference_step": 1e-10,
    "log_every": 1,
    "loss_threshold": 0.3
  },
  "comparison": {
    "lr_grid": [
      0.01,
      0.03,
      0.1,
      0.3
    ],
    "selection_seeds": {
      "start": 0,
      "count": 20
    },
    "final_seeds": {
      "start": 100,
      "count": 100
    },
    "tie_tolerance": 0.005,
    "splits": [
      "train",
      "validation",
      "test"
    ],
    "selection_split": "validation"
  },
  "models": [
    {
      "name": "B2_d40",
      "type": "photonic",
      "n_inputs": 4,
      "encoding": "hard",
      "d": 40,
      "detection": "threshold",
      "extra_modes": 2,
      "mesh_order": "ps_bs",
      "layout": "interleaved",
      "input_kind": "cluster",
      "readout": "click_parity",
      "data_reps": 3,
      "training": {
        "optimizer": "torch_adam",
        "gradient": "autograd",
        "init": {
          "low": -1.0,
          "high": 1.0
        }
      }
    },
    {
      "name": "Q3_d40",
      "type": "qubit",
      "n_qubits": 4,
      "feature_map": "zz",
      "feature_map_reps": 3,
      "ansatz_reps": 9,
      "feature_entanglement": "full",
      "ansatz_entanglement": "full",
      "hadamard_every_rep": true,
      "training": {
        "optimizer": "torch_adam",
        "gradient": "autograd",
        "init": {
          "low": -1.0,
          "high": 1.0
        }
      }
    },
    {
      "name": "Q2_d40",
      "type": "qubit",
      "n_qubits": 4,
      "feature_map": "zz",
      "feature_map_reps": 2,
      "ansatz_reps": 9,
      "feature_entanglement": "full",
      "ansatz_entanglement": "full",
      "hadamard_every_rep": true,
      "training": {
        "optimizer": "torch_adam",
        "gradient": "autograd",
        "init": {
          "low": -1.0,
          "high": 1.0
        }
      }
    },
    {
      "name": "classical_4622",
      "type": "classical",
      "sizes": [
        4,
        6,
        2,
        2
      ],
      "activation": "leaky_relu",
      "head": "softmax",
      "bias": false,
      "training": {
        "optimizer": "torch_adam",
        "gradient": "autograd",
        "init": {
          "low": -1.0,
          "high": 1.0
        }
      }
    },
    {
      "name": "classical_42",
      "type": "classical",
      "sizes": [
        4,
        2
      ],
      "activation": "leaky_relu",
      "head": "softmax",
      "bias": false,
      "training": {
        "optimizer": "torch_adam",
        "gradient": "autograd",
        "init": {
          "low": -1.0,
          "high": 1.0
        }
      }
    }
  ]
}
