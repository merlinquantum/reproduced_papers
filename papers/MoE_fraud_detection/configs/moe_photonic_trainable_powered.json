{
    "description": "STATISTICALLY-POWERED run: MerLin photonic GQC + MoE, TRAINABLE readout (nn.Linear(output_size,1)+sigmoid replacing the fixed LexGrouping) -- tests whether a trainable pooling head closes the gap to the gate model, per MERLIN_COOKBOOK.md's photonic debugging checklist. n_repeats=20 (100 folds).",

    "seed": 42,
    "dtype": "float32",
    "outdir": "outdir",
    "device": "cpu",
    "dataset": {
        "batch_size": 32
    },
    "cv": {
        "n_repeats": 20,
        "max_splits": null
    },
    "model": {
        "backend": "photonic",
        "n_qubits": 6,
        "lambda_recon": 0.5,
        "router_split": "analysis",
        "autoencoder": {
            "hidden_dims": [256, 128, 64]
        },
        "photonic": {
            "n_photons": 3,
            "readout": "trainable"
        },
        "head": {
            "hidden_dim": 8
        },
        "xgboost": {
            "n_estimators": 200,
            "max_depth": 4,
            "n_jobs": 2
        }
    },
    "training": {
        "epochs": 30,
        "lr": 1e-3
    },
    "evaluation": {
        "router_thresholds": [0.5, 0.6, 0.7, 0.8, 0.9]
    },
    "logging": {
        "level": "info",
        "save_config_snapshot": true
    }
}
