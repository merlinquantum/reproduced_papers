{
    "description": "MoE fraud detection (gate-model GQC) - paper-accurate settings: 3x repeated stratified 5-fold CV, full router-threshold sweep",
    "seed": 42,
    "dtype": "float32",
    "outdir": "outdir",
    "device": "cpu",
    "dataset": {
        "batch_size": 32
    },
    "cv": {
        "n_repeats": 3,
        "max_splits": null
    },
    "model": {
        "backend": "gate",
        "n_qubits": 6,
        "lambda_recon": 0.5,
        "autoencoder": {
            "hidden_dims": [
                256,
                128,
                64
            ]
        },
        "vqc": {
            "n_layers": 6
        },
        "head": {
            "hidden_dim": 8
        },
        "xgboost": {
            "n_estimators": 200,
            "max_depth": 4
        }
    },
    "training": {
        "epochs": 30,
        "lr": 0.001
    },
    "evaluation": {
        "router_thresholds": [
            0.5,
            0.6,
            0.7,
            0.8,
            0.9
        ]
    },
    "logging": {
        "level": "info",
        "save_config_snapshot": true
    }
}
