{
  "description": "Phase 5 selection grid (LOG.md, Phase 5 Comparison Plan): pqc_l25 from e4_cartpole_pqc_l25_codefaithful, batch 16, target update every 30; selection seeds 100-104.",
  "experiment": {
    "id": "E5-select",
    "arm": "pqc_l25_b16_t30",
    "label": "selection"
  },
  "agents": {
    "seeds": [
      100,
      101,
      102,
      103,
      104
    ]
  },
  "environment": {
    "name": "CartPole-v0",
    "is_slippery": null,
    "max_episode_steps": null,
    "solve": {
      "window": 100,
      "mean_threshold": 195.0,
      "min_episodes": 101
    }
  },
  "model": {
    "kind": "pqc",
    "n_qubits": 4,
    "n_layers": 25,
    "ansatz": "ry_rz_cz_ring",
    "state_encoding": "continuous_rx",
    "encoding_activation": "arctan",
    "data_reuploading": true,
    "train_input_weights": true,
    "readout": "cartpole_zz_pairs",
    "train_output_weights": true,
    "output_factor": 1.0,
    "theta_init": {
      "low": 0.0,
      "high": 3.141592653589793
    },
    "hidden_units": null
