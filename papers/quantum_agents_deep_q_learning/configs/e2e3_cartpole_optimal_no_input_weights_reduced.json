{
  "description": "E2 predeclared reduced override (Phase 1 RED tier): without trainable input scaling, optimal hyperparameters, 5 agents, 2000-episode cap. Label: partial.",
  "experiment": {
    "id": "E2",
    "arm": "optimal_no_input_weights_reduced",
    "label": "partial"
  },
  "agents": {
    "seeds": [
      0,
      1,
      2,
      3,
      4
    ]
  },
  "environment": {
    "name": "CartPole-v0",
    "is_slippery": null,
    "max_episode_steps": null,
    "solve": {
      "window": 100,
      "mean_threshold": 195.0,
      "min_episodes": 101
    }
  },
  "model": {
    "kind": "pqc",
    "n_qubits": 4,
    "n_layers": 5,
    "ansatz": "ry_rz_cz_ring",
    "state_encoding": "continuous_rx",
    "encoding_activation": "arctan",
    "data_reuploading": true,
    "train_input_weights": false,
    "readout": "cartpole_zz_pairs",
    "train_output_weights": true,
    "output_factor": 1.0,
    "theta_init": {
      "low": 0.0,
      "high": 3.141592653589793
    },
    "hidden_units": null
  },
  "training": {
    "max_episodes": 2000,
    "gamma": 0.99,
    "batch_size": 16,
    "update_model_every": 1,
    "update_target_every": 1,
    "replay_capacity": 10000,
    "replay_eviction": "fifo",
    "replay_sampling": "with_replacement",
    "loss_form": "action_only",
    "bootstrap_network": "target",
    "terminal_mask": "terminated_or_truncated",
    "learning_rates": {
      "main": 0.001,
      "input_weights": 0.001,
      "output_weights": 0.1
    },
    "amsgrad_main": true,
    "adam": {
      "beta1": 0.9,
      "beta2": 0.999,
      "epsilon": 1e-07
    },
    "epsilon_greedy": {
      "start": 1.0,
      "decay": 0.99,
      "min": 0.01
    }
  },
  "evaluation": {
    "greedy_episodes": 10,
    "track_q_star_mae": false
  }
}
