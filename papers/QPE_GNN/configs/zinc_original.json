{
  "description": "Paper-scale ZINC-subset regression with full GRIT and RRWP+2-QiRW. Long-running; use zinc_smoke.json for smoke.",
  "feasibility": {"status": "resource_intensive"},
  "dataset": "zinc",
  "dataset_kwargs": {"subset": true},
  "model": "grit",
  "encoding": "rrwp+qirw2",
  "rrwp_dim": 21,
  "qpe_dim": 20,
  "qpe_initial_distribution": "adjacency",
  "seeds": [0, 1, 2, 3],
  "seed": 0,
  "node_dim": 64,
  "depth": 10,
  "num_heads": 8,
  "head": "graph_reg",
  "pooling": "sum",
  "dropout": 0.0,
  "attention_dropout": 0.2,
  "epochs": 2000,
  "batch_size": 32,
  "lr": 1e-3,
  "weight_decay": 1e-5,
  "warmup_epochs": 50,
  "minimum_lr": 1e-6,
  "parameter_budget": 500000,
  "device": "cpu"
}
