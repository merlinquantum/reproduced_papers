{
    "description": "MerLin photonic linear-optics adaptation of the consistency-loss PINN on Poisson 1D.",
    "experiment": "poisson_merlin",
    "seed": 42,
    "dtype": "float64",
    "device": "cpu",
    "outdir": "outdir",
    "model": {
        "n_modes": 6,
        "input_modes": [0, 1, 2],
        "entangling_layers": 3,
        "n_photons": 3,
        "encoding_scale": 1.5707963267948966
    },
    "training": {
        "epochs": 600,
        "lr": 0.02,
        "collocation_points": 64,
        "lambdas": {"pde": 0.34, "bc": 0.34, "consistency": 0.32, "trace": 0.0},
        "log_every": 50
    },
    "logging": {"level": "info", "save_config_snapshot": true}
}
