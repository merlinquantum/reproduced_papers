{
    "description": "Classical PINN baseline matched to QPINN parameter count on Poisson 1D.",
    "experiment": "poisson_pinn",
    "seed": 42,
    "dtype": "float64",
    "device": "cpu",
    "outdir": "outdir",
    "model": {
        "name": "FCNN",
        "target_param_count": 88
    },
    "training": {
        "epochs": 2000,
        "lr": 0.01,
        "collocation_points": 258,
        "lambdas": {"pde": 0.25, "bc": 0.25, "consistency": 0.25, "trace": 0.0},
        "log_every": 100
    },
    "logging": {"level": "info", "save_config_snapshot": true}
}
