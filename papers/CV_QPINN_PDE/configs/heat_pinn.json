{
    "description": "Classical PINN baseline matched to QPINN parameter count on Heat 1D.",
    "experiment": "heat_pinn",
    "seed": 42,
    "dtype": "float64",
    "device": "cpu",
    "outdir": "outdir",
    "model": {
        "name": "FCNN",
        "target_param_count": 44
    },
    "training": {
        "pretrain_epochs": 300,
        "epochs": 1000,
        "lr": 0.01,
        "nx": 18,
        "nt": 10,
        "n_ic": 258,
        "n_bc": 16,
        "lambdas": {"pde": 0.10, "ic": 0.60, "bc": 0.10, "consistency": 0.10, "trace": 0.0},
        "eval_nx": 41,
        "eval_nt": 11,
        "log_every": 100
    },
    "logging": {"level": "info", "save_config_snapshot": true}
}
