{
    "description": "Ablation: Poisson QPINN with nested autograd (no consistency loss, no second output).",
    "experiment": "poisson_qpinn",
    "seed": 42,
    "dtype": "float64",
    "device": "cpu",
    "outdir": "outdir",
    "model": {
        "n_qumodes": 2,
        "n_multi_layers": 2,
        "n_single_layers": 2,
        "cutoff": 8,
        "active_sd": 0.001,
        "passive_sd": 0.1
    },
    "training": {
        "epochs": 200,
        "lr": 0.05,
        "collocation_points": 64,
        "lambdas": {"pde": 0.34, "bc": 0.33, "trace": 0.33, "consistency": 0.0},
        "use_nested_loss": true,
        "log_every": 25
    },
    "logging": {"level": "info", "save_config_snapshot": true}
}
