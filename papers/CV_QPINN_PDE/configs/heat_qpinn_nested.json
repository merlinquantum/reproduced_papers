{
    "description": "Ablation: Heat QPINN with nested autograd (no consistency loss).",
    "experiment": "heat_qpinn",
    "seed": 42,
    "dtype": "float64",
    "device": "cpu",
    "outdir": "outdir",
    "model": {
        "n_qumodes": 2,
        "n_multi_layers": 2,
        "n_single_layers": 2,
        "cutoff": 10,
        "active_sd": 0.001,
        "passive_sd": 0.1
    },
    "training": {
        "pretrain_epochs": 60,
        "epochs": 250,
        "lr": 0.05,
        "nx": 10,
        "nt": 8,
        "n_ic": 32,
        "n_bc": 8,
        "lambdas": {"pde": 0.10, "ic": 0.60, "bc": 0.10, "trace": 0.20, "consistency": 0.0},
        "use_nested_loss": true,
        "eval_nx": 41,
        "eval_nt": 11,
        "log_every": 25
    },
    "logging": {"level": "info", "save_config_snapshot": true}
}
