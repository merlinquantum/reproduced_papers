{
    "description": "Smoke config for the 1D heat equation QPINN reproduction.",
    "experiment": "heat_qpinn",
    "seed": 42,
    "dtype": "float64",
    "device": "cpu",
    "outdir": "outdir",
    "model": {
        "n_qumodes": 2,
        "n_multi_layers": 2,
