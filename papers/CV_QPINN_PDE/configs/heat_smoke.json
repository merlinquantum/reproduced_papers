        "lambdas": {"pde": 0.10, "ic": 0.60, "bc": 0.10, "consistency": 0.10, "trace": 0.10},
        "eval_nx": 41,
        "eval_nt": 11,
        "log_every": 25
    },
    "logging": {"level": "info", "save_config_snapshot": true}
