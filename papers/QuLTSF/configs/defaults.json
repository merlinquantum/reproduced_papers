{
  "description": "Lightweight smoke defaults: QuLTSF on 4 qubits over a small synthetic weather-like series (no download). Paper settings live in configs/table1_*.json and configs/ablation_*.json.",
  "seed": 2021,
  "dtype": "float32",
  "outdir": "outdir",
  "device": "cpu",
  "dataset": {
    "source": "synthetic",
    "name": "synthetic_weather_like",
    "synthetic": {"n_rows": 2000, "n_channels": 4, "seed": 0},
    "path": null,
    "sha256": null,
    "time_column": "date",
    "target": "OT",
    "features_mode": "M",
    "sequence_length": 48,
    "prediction_horizon": 24,
    "batch_size": 16,
    "train_ratio": 0.7,
    "test_ratio": 0.2,
    "val_drop_last": true,
    "test_drop_last": false
  },
  "model": {
    "name": "qultsf",
    "params": {
      "simulator": "torch",
      "num_qubits": 4,
      "num_layers": 3,
      "circuit": "trainable",
      "qml_device": "default.qubit"
    }
  },
  "training": {
    "epochs": 2,
    "lr": 0.001,
    "lr_schedule": "type3",
    "patience": 20,
    "max_batches_per_epoch": null
  },
  "logging": {
    "level": "info"
  }
}
