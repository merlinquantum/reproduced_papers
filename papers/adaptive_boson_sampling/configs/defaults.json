{
  "description": "Lightweight runnable default: 1D task (Fig. 5a labels), one Haar-U_0 B2 qubit kernel and an RBF baseline, paper arm only. Named configs hold the paper experiments.",
  "experiment": "classification",
  "validity": "substitute-data (regenerated 1D set, Haar-random U_0)",
  "seed": 42,
  "dtype": "float64",
  "outdir": "outdir",
  "device": "cpu",
  "dataset": {
    "name": "nonlinear_1d",
    "n_points": 15
  },
  "models": [
    {
      "label": "B2_qubit_haar_u0",
      "kind": "abs_simulated",
      "platform": "B2",
      "kernel_kind": "overlap",
      "u0": {
        "strategy": "seed",
        "seeds": [
          0
        ],
        "n_candidates": 1
      },
      "assignment": "identity"
    },
    {
      "label": "rbf_svm_x",
      "kind": "feature",
      "estimator": "rbf"
    }
  ],
  "evaluation": {
    "n_partitions": 100,
    "test_fraction": 0.2,
    "svm_C": 50,
    "arms": [
      "paper"
    ],
    "tuning": {
      "C_grid": [
        0.1,
        1,
        10,
        50,
        100
      ],
      "gamma_grid": [
        0.001,
        0.00316228,
        0.01,
        0.0316228,
        0.1,
        0.316228,
        1.0,
        3.16228,
        10.0
      ],
      "degree_grid": [
        2,
        3,
        4
      ],
      "knn_grid": [
        1,
        3,
        5
      ]
    }
  },
  "logging": {
    "level": "info"
  }
}
