{
  "description": "MerLin photonic EGAS on MGT \u2014 photonic EGAS mirror of gate-based (UNBUNCHED, 2 photons, 8 modes)",
  "seed": 0,
  "dtype": "float32",
  "outdir": "outdir",
  "device": "cpu",
  "task": "photonic_eval",
  "dataset": {
    "name": "MGT",
    "root": "data",
    "n_qubits": 8,
    "n_components": 8
  },
  "egas": {
    "seq_len": 28,
    "n_iters": 4000,
    "n_candidates": 12,
    "select_k": 6,
    "gamma": 0.1,
    "lr": 5e-05,
    "temp_max": 100.0,
    "temp_min": 0.04,
    "search_samples": 36,
    "d_model": 32,
    "n_layers": 1,
    "n_heads": 2
  },
  "photonic": {
    "n_photons": 2,
    "computation_space": "FOCK",
    "seq_len": 28,
    "scale": 1.0,
    "epochs": 120,
    "batch": 25,
    "lr": 0.001
  },
  "bias": {
    "epochs": 400,
    "batch_samples": 25,
    "lr": 0.0005
  },
  "eval": {
    "n_train": 400,
    "n_test": 50,
    "n_repeats": 8,
    "top": 4
  },
  "logging": {
    "level": "info",
    "save_config_snapshot": true
  }
}