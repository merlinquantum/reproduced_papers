{
  "description": "Fast smoke test: gate EGAS on WC dataset (30-50s runtime target)",
  "seed": 0,
  "dtype": "float64",
  "outdir": "outdir",
  "device": "cpu",
  "task": "egas_eval",
  "dataset": {
    "name": "WC",
    "root": "data",
    "n_qubits": 8,
    "n_components": 8
  },
  "egas": {
    "seq_len": 28,
    "n_iters": 20,
    "n_candidates": 6,
    "select_k": 3,
    "gamma": 0.1,
    "lr": 5e-05,
    "temp_max": 100.0,
    "temp_min": 0.04,
    "search_samples": 16,
    "d_model": 32,
    "n_layers": 1,
    "n_heads": 2
  },
  "bias": {
    "epochs": 30,
    "batch_samples": 16,
    "lr": 0.0005
  },
  "nqe": {
    "epochs": 5
  },
  "eval": {
    "n_train": 80,
    "n_test": 30,
    "n_repeats": 1,
    "top": 2
  },
  "logging": {
    "level": "info",
    "save_config_snapshot": true
  }
}
