{
  "description": "MerLin photonic fidelity-kernel QKSVM on WDGV1 (multiclass: waveform database, 2 photons, reduced training)",
  "seed": 0, "dtype": "float32", "outdir": "outdir", "device": "cpu",
  "task": "photonic_eval",
  "dataset": {"name": "WDGV1", "root": "data", "n_qubits": 8, "n_components": 20},
  "photonic": {"n_photons": 3, "computation_space": "UNBUNCHED", "seq_len": 28, "scale": 1.0, "epochs": 100, "batch": 30, "lr": 0.05},
  "eval": {"n_train": 300, "n_test": 50, "n_repeats": 5, "top": 4},
  "logging": {"level": "info", "save_config_snapshot": true}
}
