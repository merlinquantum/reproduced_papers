{
  "description": "Gate-based RF-RQKS ablation on the available 36_LTE_1 representation",
  "data_source": "representation",
  "representation_path": "representations/dct64x64_36_lte_1",
  "validation_fraction": 0.15,
  "standardization_batch_size": 64,
  "sampler": "qiskit",
  "device": "cpu",
  "seed": 42,
  "batch_size": 16,
  "readout_c": 1.0,
  "readout_max_iter": 10000,
  "scale_sampled_features": true,
  "kernel_components": 128,
  "kernel_gamma": 1.0,
  "maximum_output_features": 16384,
  "initial_depth": 1,
  "encoding_strategy": "L2",
  "entangling_strategy": "V1",
  "same_haar": false,
  "stage_1": {"qubit_counts": [2, 3, 4, 5], "episode_counts": [4, 8, 16, 32]},
  "stage_2": {"shortlist_count": 4, "depths": [1, 2, 4, 6]},
  "stage_3": {"depth_episode_pairs": [[1, 32], [2, 16], [4, 8], [5, 4]]},
  "stage_4": {"qubit_counts": [1, 2, 3, 4, 5]}
}
