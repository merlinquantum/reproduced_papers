{
  "description": "E-D: Rice PCA with the FakePerth noise model (Qiskit Aer), reduced: 12 circuits x {COBYLA 250 tol 0.1, SPSA 75 (as executed)} x {uniform arm, beta arm}, 1 seed = 48 runs. Budgets are the author's noisy Rice settings after the SPSA/Nelder-Mead swap.",
  "mode": "sweep",
  "noise": {
    "enabled": true,
    "model": "FakePerth"
  },
  "sweep": {
    "id": "E-D_rice_noisy",
    "output_dir": "outdir/sweeps/E-D_rice_noisy",
    "candidate_mode": "qnn",
    "workers": 8,
    "seeds": [
      1
    ],
    "factors": [
      {
        "name": "arm",
        "levels": [
          {
            "label": "uniformarm",
            "set": {
              "dataset.input_scaling": "raw",
              "model.init": "qiskit_default"
            }
          },
          {
            "label": "betaarm",
            "set": {
              "dataset.input_scaling": "minmax",
              "model.init": "qiskit_default"
            }
          }
        ]
      },
      {
        "name": "optimizer",
        "levels": [
          {
            "label": "cobyla",
            "set": {
              "training.optimizer": "COBYLA",
              "training.maxiter": 250,
              "training.tol": 0.1
            }
          },
          {
            "label": "spsa",
            "set": {
              "training.optimizer": "SPSA",
              "training.maxiter": 75
            }
          }
        ]
      },
      {
        "name": "circuit",
        "levels": {
          "paper_grid": [
            0,
            4,
            24,
            26,
            31,
            40,
            44,
            49,
            55,
            57,
            65,
            77
          ]
        }
      }
    ]
  }
}
