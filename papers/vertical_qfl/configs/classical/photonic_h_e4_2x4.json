{
  "description": "Phase 5 classical vertical-FL baseline, e4_2x4 layout, parameters matched to the photonic_h model; lr selected on validation.",
  "experiment": "e4_2x4_classical_photonic_h",
  "label": "classical fair baseline (Phase 5), validation-selected lr",
  "seed": 42,
  "dtype": "float32",
  "outdir": "outdir",
  "device": "cpu",
  "data_root": "../../data",
  "dataset": {
    "name": "semeion",
