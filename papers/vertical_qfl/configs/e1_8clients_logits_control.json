{
  "description": "CONTROL for E1: identical to e1_8clients_original.json except the server output is NOT passed through softmax before the cross-entropy loss (the paper's 'logits' reading). The authors' code uses softmax first.",
  "experiment": "e1_8clients_logits_control",
  "label": "control: plain logits (no softmax before cross-entropy)",
  "seed": 42,
  "dtype": "float32",
  "outdir": "outdir",
  "device": "cpu",
  "data_root": "../../data",
  "dataset": {
    "name": "semeion",
    "subdir": "vertical_qfl/semeion",
    "file": "semeion.data",
    "permutation_seed": 42,
    "partition_seed": 42,
    "test_size": 0.2,
    "batch_size": 32,
    "max_train_samples": null,
    "max_test_samples": null
  },
  "model": {
    "name": "vqfl",
    "client_slices": [
      0,
      1,
      2,
      3,
      4,
      5,
      6,
      7
    ],
    "server_encoding": "server_wide",
    "softmax_output": false,
    "n_blocks": 5,
    "depth_per_block": 100
  },
  "training": {
    "epochs": 30,
    "optimizer": "adam",
    "lr": 0.002,
    "weight_decay": 0.0
  },
  "logging": {
    "level": "info",
    "save_config_snapshot": true
  }
}
