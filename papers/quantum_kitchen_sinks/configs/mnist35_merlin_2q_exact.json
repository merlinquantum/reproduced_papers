{
    "description": "Photonic MerLin QKS on (3,5)-MNIST, two independent dual-rail qubits with balanced 50:50 MZIs (no entangler).",
    "experiment": "mnist35_merlin",
    "seeds": [
        42,
        43,
        44
    ],
    "dataset": {
        "name": "mnist35",
        "n_train": 4000,
        "n_test": 1000,
        "standardize": true
    },
    "qks": {
        "backend": "photonic_merlin",
        "n_modes": 4,
        "n_photons": 2,
        "encoding": "tile",
        "n_episodes": 2500,
        "sigma": 0.1,
        "shots_per_episode": 1,
        "n_layers": 1,
        "input_modes": [
            0,
            2
        ],
        "angle_scale": 1.0,
        "computation_space": "DUAL_RAIL",
        "architecture": "dual_rail_mzi",
        "mesh_after": false
    },
    "classifier": {
        "kind": "logistic_regression",
        "C": 1.0,
        "max_iter": 4000
    }
}
