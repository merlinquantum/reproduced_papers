{
    "description": "Photonic MerLin QKS on picture frames, two dual-rail qubits with balanced 50:50 MZIs.",
    "experiment": "picture_frames",
    "seeds": [
        42,
        43,
        44
    ],
    "dataset": {
        "name": "picture_frames",
        "n_train": 1600,
        "n_test": 400,
        "inner_radius": 0.4,
        "outer_radius": 0.7,
        "noise": 0.02
    },
    "qks": {
        "backend": "photonic_merlin",
        "n_modes": 4,
        "n_photons": 2,
        "encoding": "split",
        "n_episodes": 5000,
        "sigma": 1.0,
        "shots_per_episode": 1,
        "n_layers": 1,
        "input_modes": [
            0,
            2
        ],
        "angle_scale": 1.0,
        "computation_space": "DUAL_RAIL",
        "architecture": "dual_rail_mzi",
        "mesh_after": false
    },
    "sigma_sweep": [
        1.0,
        2.0,
        4.0
    ],
    "episodes_sweep": [
        500,
        1000,
        5000
    ],
    "classifier": {
        "kind": "logistic_regression",
        "C": 1.0,
        "max_iter": 4000
    }
}
