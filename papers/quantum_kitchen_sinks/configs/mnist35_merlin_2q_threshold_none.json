{
    "experiment": "mnist35_merlin",
    "seeds": [
        42,
        43,
        44
    ],
    "dataset": {
        "name": "mnist35",
        "n_train": 4000,
        "n_test": 1000,
        "standardize": true
    },
    "classifier": {
        "kind": "logistic_regression",
        "C": 1.0,
        "max_iter": 4000
    },
    "description": "As mnist35_merlin_2q_threshold_splitter but with no mixing layer: the control showing that the entangler is not what produces the lift.",
    "qks": {
        "backend": "photonic_merlin",
        "n_modes": 4,
        "n_photons": 2,
        "encoding": "tile",
        "n_episodes": 2500,
        "sigma": 0.1,
        "shots_per_episode": 1,
        "n_layers": 1,
        "angle_scale": 1.0,
        "architecture": "mzi_threshold",
        "mixing": "none"
    }
}
